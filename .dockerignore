# Mirror .gitignore — do NOT strip tracked files. Go's automatic VCS
# stamping (vcs.modified) compares the build tree to git's index, so
# excluding a tracked file via .dockerignore makes the binary report
# (dirty) even on a clean commit.

# Logs
logs
*.log

# Node + Vite
node_modules
dist
dist-ssr
*.local
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Editor / OS junk
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo

# Tauri (Rust target + sidecar binaries — huge, not tracked)
src-tauri/target
src-tauri/binaries
src-tauri/gen

# Server build outputs
/build
/dist-server
/dist-bin

# Claude Code runtime state
.claude/scheduled_tasks.lock

# Plan scratchpad (local-only)
/TASKS.md

# Generated bundle under site/
/site/intro
